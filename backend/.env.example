# SCROLLECT backend environment (copy to .env and fill in)
# NEVER commit .env. All secrets below are placeholders.

# --- App ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MOCK_MODE=true  -> uses MockIgClient + seeded creators/reels; no Meta credentials needed.
# MOCK_MODE=false -> requires real Meta app credentials (see README runbook §Meta setup).
MOCK_MODE=true

# --- Auth / secrets (generate real values) ---
# openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-0123456789abcdef
# openssl rand -hex 32  (used for AES-256-GCM encryption of creator tokens at rest)
ENCRYPTION_KEY=change-me-encryption-key-0123456789abcdef0123456789abcdef

# --- Instagram (official Graph API with Instagram Login) ---
# Meta app: https://developers.facebook.com/apps -> Business type -> Instagram product
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/auth/ig/callback
# The app_secret is also the webhook verify/signature secret for Instagram webhooks
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=scrollect-webhook-verify

# --- Database (Postgres 16, via deploy/docker-compose.yml or local) ---
# docker compose (deploy/docker-compose.yml): postgresql://scrollect:scrollect@localhost:5432/scrollect
# homebrew Postgres:                          postgresql://$(whoami)@localhost:5432/scrollect
DATABASE_URL=postgresql://scrollect:scrollect@localhost:5432/scrollect

# --- Redis (queues + rate buckets + cache). Unset in mock/no-docker mode. ---
REDIS_URL=

# --- Video pipeline (Mux per spec §A.1; Cloudflare Stream alternative) ---
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_TOKEN=
